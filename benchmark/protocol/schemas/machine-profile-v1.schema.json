{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "machine-profile-v1.schema.json",
  "title": "CSV2 controlled benchmark machine profile v1 binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "profile", "digest", "observation"],
  "properties": {
    "artifact": {"$ref": "#/$defs/artifact"},
    "profile": {"$ref": "#/$defs/profile"},
    "digest": {"$ref": "#/$defs/sha256"},
    "observation": {"$ref": "#/$defs/observation"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256", "mtime_ns"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "mtime_ns": {"type": "integer", "minimum": 0}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "id", "system", "architecture", "cpu_model",
        "logical_cpus", "allowed_affinity", "kernel_release", "governor",
        "turbo_boost"
      ],
      "properties": {
        "schema": {"const": "csv2-machine-profile-v1"},
        "id": {"type": "string", "minLength": 1},
        "system": {"const": "Linux"},
        "architecture": {"type": "string", "minLength": 1},
        "cpu_model": {"type": "string", "minLength": 1},
        "logical_cpus": {"type": "integer", "minimum": 1},
        "allowed_affinity": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "kernel_release": {"type": "string", "minLength": 1},
        "governor": {"type": "string", "minLength": 1},
        "turbo_boost": {"enum": ["enabled", "disabled", "unavailable"]}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system", "architecture", "cpu_model", "logical_cpus",
        "process_affinity", "kernel_release", "governor", "turbo_boost"
      ],
      "properties": {
        "system": {"const": "Linux"},
        "architecture": {"type": "string", "minLength": 1},
        "cpu_model": {"type": "string", "minLength": 1},
        "logical_cpus": {"type": "integer", "minimum": 1},
        "process_affinity": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "kernel_release": {"type": "string", "minLength": 1},
        "governor": {"type": "string", "minLength": 1},
        "turbo_boost": {"enum": ["enabled", "disabled", "unavailable"]}
      }
    }
  }
}
