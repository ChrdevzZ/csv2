{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CSV2 fixed-machine metrics v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "evidence_level", "decision_eligible",
    "generated_at_utc", "machine", "compiler", "compiler_identity",
    "compiler_flags", "operation", "source", "runs", "artifacts", "clean_build",
    "post_build"
  ],
  "properties": {
    "schema": {"const": "csv2-fixed-machine-metrics-v3"},
    "status": {"enum": ["running", "completed", "failed"]},
    "evidence_level": {"enum": ["exploratory", "controlled"]},
    "decision_eligible": {"type": "boolean"},
    "generated_at_utc": {"type": "string", "minLength": 1},
    "completed_at_utc": {"type": "string", "minLength": 1},
    "error": {"type": "string", "minLength": 1},
    "machine": {
      "type": "object",
      "required": [
        "system", "release", "machine", "node", "cpu_model",
        "cpu_model_source", "logical_cpus", "process_affinity", "python"
      ],
      "properties": {
        "logical_cpus": {"type": "integer", "minimum": 1},
        "process_affinity": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "items": {"type": "integer", "minimum": 0}}
          ]
        }
      },
      "additionalProperties": true
    },
    "compiler": {"type": "string", "minLength": 1},
    "compiler_identity": {"type": ["object", "null"]},
    "compiler_flags": {"type": "string"},
    "operation": {"type": "string", "minLength": 1},
    "source": {"enum": ["buffer", "mmap", "file"]},
    "runs": {"type": "integer", "minimum": 1},
    "artifacts": {
      "type": "object",
      "required": ["collector", "executable", "allocation_executable", "dataset"],
      "properties": {
        "collector": {"$ref": "#/$defs/source_bundle"},
        "executable": {"$ref": "#/$defs/revision_artifact"},
        "allocation_executable": {"$ref": "#/$defs/revision_artifact"},
        "dataset": {"$ref": "#/$defs/artifact"},
        "compiler_executable": {"$ref": "#/$defs/artifact"},
        "compile_commands": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": false
    },
    "clean_build": {"oneOf": [{"$ref": "#/$defs/build"}, {"type": "null"}]},
    "post_build": {"oneOf": [{"$ref": "#/$defs/invocation"}, {"type": "null"}]},
    "verification": {"$ref": "#/$defs/verification"},
    "allocations": {"$ref": "#/$defs/allocations"},
    "timing": {"$ref": "#/$defs/timing"},
    "timing_invocation": {"$ref": "#/$defs/invocation"},
    "pmu": {"oneOf": [{"$ref": "#/$defs/pmu_timing"}, {"type": "null"}]},
    "pmu_invocation": {"$ref": "#/$defs/invocation"},
    "peak_rss": {"oneOf": [{"$ref": "#/$defs/peak_rss"}, {"type": "null"}]},
    "code_size": {"oneOf": [{"$ref": "#/$defs/code_size"}, {"type": "null"}]}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "size", "sha256", "mtime_ns"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mtime_ns": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "revision_artifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"required": ["revision"], "properties": {"revision": {"type": "string", "minLength": 1}}}
      ]
    },
    "source_bundle": {
      "type": "object",
      "required": ["kind", "root", "revision", "sha256", "files"],
      "properties": {
        "kind": {"const": "source-bundle"},
        "root": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
      },
      "additionalProperties": false
    },
    "invocation": {
      "type": "object",
      "required": ["command", "stdout", "stderr"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["median", "mad"],
      "properties": {
        "median": {"type": "number", "exclusiveMinimum": 0},
        "mad": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "timing_sample": {
      "type": "object",
      "required": ["name", "seconds", "bytes_per_second", "items_per_second"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "seconds": {"type": "number", "exclusiveMinimum": 0},
        "bytes_per_second": {"type": "number", "minimum": 0},
        "items_per_second": {"type": "number", "minimum": 0},
        "pmu": {
          "type": "object",
          "required": ["cycles", "instructions", "branch-misses"],
          "properties": {
            "cycles": {"type": "number", "minimum": 0},
            "instructions": {"type": "number", "minimum": 0},
            "branch-misses": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "required": ["benchmark", "runs", "samples", "bytes_per_second", "seconds"],
      "properties": {
        "benchmark": {"type": "string", "minLength": 1},
        "runs": {"type": "integer", "minimum": 1},
        "samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/timing_sample"}},
        "bytes_per_second": {"$ref": "#/$defs/summary"},
        "seconds": {"$ref": "#/$defs/summary"}
      },
      "additionalProperties": false
    },
    "pmu_timing": {
      "allOf": [
        {"$ref": "#/$defs/timing"},
        {"properties": {"samples": {"items": {"required": ["pmu"]}}}}
      ]
    },
    "verification": {
      "type": "object",
      "required": ["result", "invocation"],
      "properties": {
        "result": {
          "type": "object",
          "required": [
            "protocol", "revision", "operation", "source", "dataset", "checksum",
            "bytes", "rows", "cells", "allocations", "allocated_bytes"
          ],
          "properties": {
            "protocol": {"const": "csv2-current-v2"},
            "revision": {"type": "string", "minLength": 1},
            "operation": {"type": "string", "minLength": 1},
            "source": {"enum": ["buffer", "mmap", "file"]},
            "dataset": {"type": "string", "minLength": 1},
            "checksum": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
            "bytes": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
            "rows": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
            "cells": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
            "allocations": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
            "allocated_bytes": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}
          },
          "additionalProperties": false
        },
        "invocation": {"$ref": "#/$defs/invocation"}
      },
      "additionalProperties": false
    },
    "allocations": {
      "type": "object",
      "required": ["count", "bytes", "invocation"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "invocation": {"$ref": "#/$defs/invocation"}
      },
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "required": ["command", "seconds", "stdout", "stderr"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "seconds": {"type": "number", "exclusiveMinimum": 0},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"}
      },
      "additionalProperties": false
    },
    "peak_rss": {
      "type": "object",
      "required": ["scope", "kib", "command", "stdout", "stderr"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "kib": {"type": "integer", "minimum": 1},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"}
      },
      "additionalProperties": false
    },
    "code_size": {
      "type": "object",
      "properties": {
        "file_bytes": {"type": "integer", "minimum": 1},
        "method": {"type": "string", "minLength": 1},
        "text_bytes": {"type": "integer", "minimum": 0},
        "data_bytes": {"type": "integer", "minimum": 0},
        "bss_bytes": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 1},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "oneOf": [
        {
          "required": ["file_bytes", "method"]
        },
        {
          "required": ["text_bytes", "data_bytes", "bss_bytes", "total_bytes", "command"]
        }
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
      "then": {
        "required": ["completed_at_utc", "verification", "allocations", "timing", "timing_invocation"]
      }
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
      "then": {"required": ["error"]}
    },
    {
      "if": {"properties": {"decision_eligible": {"const": true}}, "required": ["decision_eligible"]},
      "then": {
        "properties": {"status": {"const": "completed"}, "evidence_level": {"const": "controlled"}}
      }
    },
    {
      "if": {"properties": {"evidence_level": {"const": "controlled"}}, "required": ["evidence_level"]},
      "then": {
        "properties": {
          "runs": {"minimum": 20},
          "machine": {"properties": {"process_affinity": {"type": "array", "minItems": 1}}},
          "compiler_identity": {
            "type": "object",
            "required": ["artifact", "compile_command_matches", "version_command", "version_stdout", "version_stderr"],
            "properties": {"compile_command_matches": {"type": "integer", "minimum": 1}}
          },
          "artifacts": {"required": ["compiler_executable", "compile_commands"]}
        }
      }
    },
    {
      "if": {
        "properties": {"evidence_level": {"const": "controlled"}, "status": {"const": "completed"}},
        "required": ["evidence_level", "status"]
      },
      "then": {
        "required": ["pmu", "pmu_invocation", "peak_rss", "code_size", "post_build"],
        "properties": {
          "clean_build": {"$ref": "#/$defs/build"},
          "post_build": {"$ref": "#/$defs/invocation"},
          "pmu": {"$ref": "#/$defs/pmu_timing"},
          "peak_rss": {"$ref": "#/$defs/peak_rss"},
          "code_size": {
            "required": ["text_bytes", "data_bytes", "bss_bytes", "total_bytes", "command"]
          }
        }
      }
    }
  ]
}
