if(DEFINED CSV2_BENCHMARK_WIRE)
  set(csv2_wire "${CSV2_BENCHMARK_WIRE}")
else()
  set(csv2_command)
  set(csv2_command_started FALSE)
  math(EXPR csv2_last_argument "${CMAKE_ARGC} - 1")
  foreach(index RANGE 0 ${csv2_last_argument})
    if(csv2_command_started)
      string(REPLACE ";" "\\;" argument "${CMAKE_ARGV${index}}")
      list(APPEND csv2_command "${argument}")
    elseif(CMAKE_ARGV${index} STREQUAL "--")
      set(csv2_command_started TRUE)
    endif()
  endforeach()
  if(NOT csv2_command)
    message(FATAL_ERROR "Missing benchmark command")
  endif()
  execute_process(
    COMMAND ${csv2_command}
    RESULT_VARIABLE csv2_result
    OUTPUT_VARIABLE csv2_wire
    ERROR_VARIABLE csv2_error)
  if(NOT csv2_result STREQUAL "0")
    message(FATAL_ERROR
      "Benchmark verification failed (${csv2_result}): ${csv2_error}")
  endif()
endif()

function(csv2_wire_field name output)
  string(REGEX MATCHALL "[ \t\r\n]${name}=" occurrences " ${csv2_wire}")
  list(LENGTH occurrences count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "Benchmark wire must contain exactly one ${name} field")
  endif()
  string(REGEX MATCH "(^|[ \t\r\n])${name}=([^ \t\r\n]+)" match "${csv2_wire}")
  if(NOT match)
    message(FATAL_ERROR "Benchmark wire has no non-empty ${name} field: ${csv2_wire}")
  endif()
  set(${output} "${CMAKE_MATCH_2}" PARENT_SCOPE)
endfunction()

get_cmake_property(csv2_variables VARIABLES)
foreach(variable IN LISTS csv2_variables)
  if(variable MATCHES "^CSV2_EXPECTED_(.+)$")
    string(TOLOWER "${CMAKE_MATCH_1}" field_name)
    csv2_wire_field("${field_name}" value)
    if(NOT value STREQUAL "${${variable}}")
      message(FATAL_ERROR
        "Benchmark ${field_name} mismatch: expected ${${variable}}, got ${value}")
    endif()
  endif()
endforeach()
string(REPLACE "," ";" csv2_positive_fields "${CSV2_POSITIVE_FIELDS}")
foreach(field IN LISTS csv2_positive_fields)
  csv2_wire_field("${field}" value)
  if(NOT value MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "Benchmark ${field} must be a positive integer, got ${value}")
  endif()
endforeach()
if(DEFINED CSV2_REQUIRED_OPERATION_CONTRACT)
  csv2_wire_field(operation_contracts contracts)
  list(FIND contracts "${CSV2_REQUIRED_OPERATION_CONTRACT}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "Missing operation contract: ${CSV2_REQUIRED_OPERATION_CONTRACT}")
  endif()
endif()
